{
  "manifest_version": 3,
  "name": "GitHub PR - required approvals",
  "version": "1.4.0",
  "description": "Shows under Reviewers which CODEOWNERS approvals a pull request needs, with AND / OR and the folders that triggered them.",
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
